# LLM Provider Configuration (optional)
# Set to "openai", "anthropic", or "stub" (stub disables LLM)
LLM_PROVIDER=stub

# LLM Model Name
LLM_MODEL=gpt-4o-mini

# LLM API Key (required if LLM_PROVIDER is openai or anthropic)
LLM_API_KEY=

# GitHub Token (optional, increases rate limits)
GITHUB_TOKEN=
