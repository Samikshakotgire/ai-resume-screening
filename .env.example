# LLM Provider Configuration
# Options: openai | anthropic | gemini | ollama | stub
LLM_PROVIDER=gemini

# LLM Model Name (provider-specific)
# Gemini: gemini-3.5-flash-lite (free tier)
# OpenAI: gpt-4o-mini
# Anthropic: claude-3-haiku-20240307
LLM_MODEL=gemini-3.5-flash-lite

# LLM API Key (required for openai/anthropic/gemini)
# Get free Gemini key at: https://aistudio.google.com/apikey
LLM_API_KEY=

# GitHub Token (optional, increases rate limits)
GITHUB_TOKEN=
